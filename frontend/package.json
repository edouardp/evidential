{
  "name": "evidential-frontend",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "node build.js",
    "check-bundle": "node check_bundle.js",
    "dev": "esbuild src/index.js --bundle --format=esm --sourcemap --outfile=../src/evidential/static/table.js --watch",
    "test": "node --test test_*.js",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "typecheck": "tsc --noEmit",
    "coverage": "node --test --experimental-test-coverage --test-coverage-include='src/**' --test-coverage-lines=95 --test-coverage-branches=85 test_*.js"
  },
  "dependencies": {
    "chroma-js": "2.6.0",
    "ssf": "0.11.2"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "esbuild": "0.25.10",
    "eslint": "10.14.0",
    "globals": "17.14.0",
    "jsdom": "^26.1.0",
    "typescript": "5.9.3"
  },
  "overrides": {
    "minimatch": "11.0.4"
  }
}
